{
	"name": "vscode-terratidy",
	"displayName": "TerraTidy for VS Code",
	"description": "TerraTidy - Terraform and Terragrunt quality platform for formatting, style checking, linting, and policy enforcement",
	"version": "0.2.0",
	"publisher": "santosr2",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/santosr2/TerraTidy"
	},
	"engines": {
		"vscode": "^1.110.0"
	},
	"categories": [
		"Linters",
		"Formatters",
		"Programming Languages"
	],
	"keywords": [
		"terraform",
		"terragrunt",
		"hcl",
		"tf",
		"tfvars",
		"linter",
		"formatter",
		"style checker",
		"policy enforcement",
		"infrastructure as code",
		"iac"
	],
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#5C4EE5",
		"theme": "dark"
	},
	"activationEvents": [
		"workspaceContains:**/*.tf",
		"workspaceContains:**/*.tfvars",
		"workspaceContains:**/*.hcl",
		"workspaceContains:.terratidy.yaml",
		"workspaceContains:.terratidy.yml",
		"workspaceContains:terratidy.yaml",
		"workspaceContains:terratidy.yml"
	],
	"extensionKind": [
		"workspace"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "terratidy.init",
				"title": "TerraTidy: Initialize Configuration"
			},
			{
				"command": "terratidy.showOutput",
				"title": "TerraTidy: Show Output"
			},
			{
				"command": "terratidy.restartServer",
				"title": "TerraTidy: Restart Language Server"
			}
		],
		"configuration": {
			"title": "TerraTidy",
			"properties": {
				"terratidy.executablePath": {
					"type": "string",
					"default": "",
					"description": "Path to the terratidy executable. Leave empty to use PATH."
				},
				"terratidy.configPath": {
					"type": "string",
					"default": "",
					"description": "Path to terratidy configuration file. Leave empty to use default (.terratidy.yaml)."
				},
				"terratidy.profile": {
					"type": "string",
					"default": "",
					"description": "Configuration profile to use."
				},
				"terratidy.engines.fmt": {
					"type": "boolean",
					"default": true,
					"description": "Enable format engine."
				},
				"terratidy.engines.style": {
					"type": "boolean",
					"default": true,
					"description": "Enable style engine."
				},
				"terratidy.engines.lint": {
					"type": "boolean",
					"default": true,
					"description": "Enable lint engine."
				},
				"terratidy.engines.policy": {
					"type": "boolean",
					"default": false,
					"description": "Enable policy engine."
				},
				"terratidy.severityThreshold": {
					"type": "string",
					"enum": [
						"info",
						"warning",
						"error"
					],
					"default": "warning",
					"description": "Minimum severity level to show in diagnostics."
				},
				"terratidy.trace.server": {
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the TerraTidy language server."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "bun run bundle",
		"bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "biome check src",
		"lint:fix": "biome check --write src",
		"format": "biome format --write src",
		"pretest": "bun run compile",
		"test": "vscode-test",
		"package": "vsce package",
		"publish": "vsce publish",
		"package:pre": "vsce package --pre-release",
		"publish:pre": "vsce publish --pre-release"
	},
	"dependencies": {
		"vscode-languageclient": "^10.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.0.0",
		"@types/vscode": "^1.110.0",
		"@vscode/test-cli": "~0.0.12",
		"@vscode/test-electron": "^3.0.0",
		"@vscode/vsce": "^3.7.1",
		"esbuild": "^0.28.1",
		"mocha": "^11.7.5",
		"typescript": "^6.0.2"
	},
	"overrides": {
		"fast-uri": "^3.1.2",
		"form-data": "^4.0.6",
		"js-yaml": "^4.2.0",
		"linkify-it": "^5.0.1",
		"markdown-it": "^14.2.0",
		"qs": "^6.15.2",
		"tmp": "^0.2.6",
		"undici": "^7.28.0"
	}
}
